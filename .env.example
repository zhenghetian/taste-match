# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=
ANHAO_LLM_TIMEOUT_MS=20000
ANHAO_LLM_MAX_TOKENS=4096
ANHAO_LLM_DAILY_LIMIT=100
ANHAO_LLM_USER_DAILY_LIMIT=10
ANHAO_LLM_CONCURRENCY=2
# Official API enables server-side refusal fallback by default; gateways default off.
# ANHAO_LLM_SERVER_FALLBACKS=false
