PORT=4173
HOST=127.0.0.1
NODE_ENV=development
DATA_DIR=./data
DEV_OTP_CODE=246810
BETA_TEST_CODE=
ADMIN_KEY=replace-with-a-long-random-secret

# Production integrations
SMS_WEBHOOK_URL=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
PUBLIC_URL=https://example.com
MODERATION_WEBHOOK_URL=

# AI suggestions: injected by the shell or hosting platform; no key belongs in Git.
ANHAO_LLM_ENABLED=false
ANHAO_LLM_PROVIDER=anthropic
# Leave empty to use the provider default (Anthropic: claude-opus-5-5; DeepSeek: deepseek-flash).
ANHAO_LLM_MODEL=
# DeepSeek: set ANHAO_LLM_PROVIDER=deepseek and inject DEEPSEEK_API_KEY in the host.
# Direct endpoint: https://api.deepseek.com/anthropic; no desktop proxy required.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Cloud: use an independently hosted HTTPS gateway, never localhost or a laptop proxy.
# Explicit ANHAO_LLM_MODEL wins; otherwise gateways may use ANTHROPIC_DEFAULT_OPUS_MODEL.
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_DEFAULT_OPUS_MODEL=
# Check without requests: npm run ai:doctor -- --cloud
# Three synthetic live requests: npm run ai:smoke -- --all --cloud
ANHAO_LLM_TIMEOUT_MS=20000
ANHAO_LLM_MAX_TOKENS=4096
ANHAO_LLM_DAILY_LIMIT=100
ANHAO_LLM_USER_DAILY_LIMIT=10
ANHAO_LLM_CONCURRENCY=2
# Official API enables server-side refusal fallback by default; gateways default off.
# ANHAO_LLM_SERVER_FALLBACKS=false
